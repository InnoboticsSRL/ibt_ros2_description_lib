<?xml version="1.0" encoding="utf-8"?>
<robot name="grip_schmalz" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find grip_schmalz)/urdf/grip_schmalz.urdf.xacro"/>
    
    <link name="world"/>
    <xacro:grip_schmalz name="grip_schmalz" parent="world">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:grip_schmalz>

</robot>