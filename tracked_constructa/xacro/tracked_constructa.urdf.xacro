<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="tracked_constructa">

    <xacro:arg name="prefix" default="tracked" />
    <xacro:include filename="$(find tracked_constructa)/xacro/tracked_constructa.xacro" />
    <xacro:include filename="$(find tracked_constructa)/xacro/tracked_constructa.ros2_control.xacro" />


    <xacro:tracked_constructa prefix="$(arg prefix)">
        <origin xyz="0 0 0" rpy="0 0 0" />
    </xacro:tracked_constructa>
    <xacro:tracked_constructa_ros2_control
        name="DiffBot" prefix="$(arg prefix)" use_mock_hardware="false"/>

</robot>