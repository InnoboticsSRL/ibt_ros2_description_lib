<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="tracked_constructa"
        params="
        prefix:='tracked_constructa' 
        connected_to:='' 
        *origin"
    >

        <!-- virtual joint -->
        <xacro:unless value="${not connected_to}">
            <joint name="world" type="fixed">
                <parent link="${connected_to}" />
                <child link="${prefix}_base_link" />
                <xacro:insert_block name="origin" />
            </joint>
        </xacro:unless>

        <link
            name="${prefix}_base_link">
            <inertial>
                <origin
                    xyz="-0.0032553 0.00058223 0.2389"
                    rpy="0 0 0" />
                <mass
                    value="827.12" />
                <inertia
                    ixx="30.917"
                    ixy="-0.023393"
                    ixz="9.441"
                    iyy="208.62"
                    iyz="-0.0088913"
                    izz="192.94" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/base_link.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.77647 0.75686 0.73725 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/base_link.STL" />
                </geometry>
            </collision>
        </link>
        <link
            name="${prefix}_wheel_right">
            <inertial>
                <origin
                    xyz="2.4228E-05 -5.2484E-06 -0.05"
                    rpy="0 0 0" />
                <mass
                    value="0.2419" />
                <inertia
                    ixx="0.00020763"
                    ixy="3.052E-23"
                    ixz="1.4093E-18"
                    iyy="0.00020763"
                    iyz="-1.2101E-18"
                    izz="1.2095E-05" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/wheel_right.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.77647 0.75686 0.73725 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/wheel_right.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_wheel_right"
            type="revolute">
            <origin
                xyz="-0.68249 -0.71198 0.29748"
                rpy="1.5708 0 0" />
            <parent
                link="${prefix}_base_link" />
            <child
                link="${prefix}_wheel_right" />
            <axis
                xyz="0 0 1" />
            <limit
                lower="-1E-16"
                upper="1E+16"
                effort="0"
                velocity="0" />
        </joint>
        <link
            name="${prefix}_wheel_left">
            <inertial>
                <origin
                    xyz="2.4199E-05 1.2367E-05 0.05"
                    rpy="0 0 0" />
                <mass
                    value="0.2419" />
                <inertia
                    ixx="0.00020763"
                    ixy="2.6987E-53"
                    ixz="-5.1095E-36"
                    iyy="0.00020763"
                    iyz="-2.3373E-37"
                    izz="1.2095E-05" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/wheel_left.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.77647 0.75686 0.73725 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/wheel_left.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_wheel_left"
            type="revolute">
            <origin
                xyz="-0.68249 0.71198 0.29746"
                rpy="1.5708 0 0" />
            <parent
                link="${prefix}_base_link" />
            <child
                link="${prefix}_wheel_left" />
            <axis
                xyz="0 0 -1" />
            <limit
                lower="-1E-16"
                upper="1E+16"
                effort="0"
                velocity="0" />
        </joint>
        <link
            name="${prefix}_robot_base_link">
            <inertial>
                <origin
                    xyz="5.5511E-17 1.2072E-16 -0.01498"
                    rpy="0 0 0" />
                <mass
                    value="50.758" />
                <inertia
                    ixx="1.9089"
                    ixy="1.6591E-16"
                    ixz="-1.2712E-19"
                    iyy="1.9089"
                    iyz="-6.6393E-15"
                    izz="3.8104" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/robot_base_link.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.77647 0.75686 0.73725 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/robot_base_link.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_robot_base_link"
            type="fixed">
            <origin
                xyz="0.2215 0 0.37377"
                rpy="0 0 0" />
            <parent
                link="${prefix}_base_link" />
            <child
                link="${prefix}_robot_base_link" />
            <axis
                xyz="0 0 0" />
        </joint>
        <link
            name="${prefix}_lidar_1">
            <inertial>
                <origin
                    xyz="0.79861 2.8555E-08 -0.014039"
                    rpy="0 0 0" />
                <mass
                    value="5816.8" />
                <inertia
                    ixx="28155"
                    ixy="-9.4051E-06"
                    ixz="254.35"
                    iyy="14577"
                    iyz="7.565E-06"
                    izz="42723" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/lidar_1.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.77647 0.75686 0.73725 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/lidar_1.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_lidar_1"
            type="fixed">
            <origin
                xyz="-0.9335 0.84997 0.19"
                rpy="-3.1416 0.017453 2.3562" />
            <parent
                link="${prefix}_base_link" />
            <child
                link="${prefix}_lidar_1" />
            <axis
                xyz="0 0 0" />
        </joint>
        <link
            name="${prefix}_lidar_2">
            <inertial>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <mass
                    value="0" />
                <inertia
                    ixx="0"
                    ixy="0"
                    ixz="0"
                    iyy="0"
                    iyz="0"
                    izz="0" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/lidar_2.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="1 1 1 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tracked_constructa/meshes/lidar_2.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_lidar_2"
            type="fixed">
            <origin
                xyz="0.991504423857657 -0.849972187217018 0.189999999999997"
                rpy="-3.14159265349393 0.017453292492991 -0.785398163455891" />
            <parent
                link="${prefix}_base_link" />
            <child
                link="${prefix}_lidar_2" />
            <axis
                xyz="0 0 0" />
        </joint>

    </xacro:macro>

</robot>