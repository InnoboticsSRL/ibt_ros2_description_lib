<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="camera_tray"
        params="
        prefix:='camera_tray' 
        connected_to:='' 
        *origin"
    >

        <!-- virtual joint -->
        <xacro:unless value="${not connected_to}">
            <joint name="${prefix}_vj" type="fixed">
                <parent link="${connected_to}" />
                <child link="${prefix}_camera_fix" />
                <xacro:insert_block name="origin" />
            </joint>
        </xacro:unless>

        <link
            name="${prefix}_camera_fix">
            <inertial>
                <origin
                    xyz="0.00093904 -0.0072336 0.013727"
                    rpy="0 0 0" />
                <mass
                    value="0.65552" />
                <inertia
                    ixx="0.00019435"
                    ixy="7.7148E-06"
                    ixz="-3.2724E-06"
                    iyy="0.00042405"
                    iyz="-2.4049E-06"
                    izz="0.00059504" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://camera_tray/meshes/camera_fix.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.79216 0.81961 0.93333 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://camera_tray/meshes/camera_fix.STL" />
                </geometry>
            </collision>
        </link>
        <link
            name="${prefix}_view">
            <inertial>
                <origin
                    xyz="-2.6597E-19 4.3368E-19 -0.0025"
                    rpy="0 0 0" />
                <mass
                    value="0.0030238" />
                <inertia
                    ixx="2.5198E-08"
                    ixy="-2.4654E-40"
                    ixz="-2.3245E-40"
                    iyy="2.5198E-08"
                    iyz="-1.7264E-40"
                    izz="3.7797E-08" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://camera_tray/meshes/view.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.77647 0.75686 0.73725 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://camera_tray/meshes/view.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_view"
            type="fixed">
            <origin
                xyz="0.0015 -0.00634 0.03162"
                rpy="0 0 3.1416" />
            <parent
                link="${prefix}_camera_fix" />
            <child
                link="${prefix}_view" />
            <axis
                xyz="0 0 0" />
        </joint>


    </xacro:macro>
</robot>