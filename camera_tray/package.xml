<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>camera_tray</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for camera_tray</p>
    <p>This package contains configuration data, 3D models and launch files for camera_tray robot</p>
  </description>

  <maintainer email="mattia.deirossi@innobotics.it">Mattia Dei Rossi</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>