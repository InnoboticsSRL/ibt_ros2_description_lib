<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:macro name="bucket_gripper"
    params="
      prefix:='bucket_gripper'
      connected_to:=''
      *origin"
  >

    <!-- ================================================================
         Virtual joint: attaches this tool to a parent link (optional)
         ================================================================ -->
    <xacro:unless value="${not connected_to}">
      <joint name="${prefix}_vj" type="fixed">
        <parent link="${connected_to}" />
        <child link="${prefix}_base_link" />
        <xacro:insert_block name="origin" />
      </joint>
    </xacro:unless>

    <!-- ================================================================
         Links
         ================================================================ -->

    <link name="${prefix}_base_link">
      <inertial>
        <origin xyz="-2.3651E-06 -4.3839E-06 0.063528" rpy="0 0 0" />
        <mass value="3.8087" />
        <inertia
          ixx="0.070068"  ixy="1.0646E-07" ixz="4.2826E-09"
          iyy="0.0016823" iyz="-2.5893E-08"
          izz="0.07095" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/base_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/base_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_bucket_link">
      <inertial>
        <origin xyz="8.4412E-15 2.092E-06 -0.05627" rpy="0 0 0" />
        <mass value="1.124" />
        <inertia
          ixx="0.0019399" ixy="4.5E-20"   ixz="-6.715E-21"
          iyy="0.0022422" iyz="-5.15E-19"
          izz="0.001098" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/bucket_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.86667 0.86667 0.8902 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/bucket_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_adapter_link">
      <inertial>
        <origin xyz="-2.7992E-15 8.193E-16 -0.0044409" rpy="0 0 0" />
        <mass value="0.40686" />
        <inertia
          ixx="0.00022117" ixy="8.1944E-07" ixz="1.4492E-20"
          iyy="0.00060509" iyz="1.1647E-21"
          izz="0.00082067" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/adapter_link.STL" />
        </geometry>
        <material name="">
          <color rgba="0.75294 0.75294 0.75294 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/adapter_link.STL" />
        </geometry>
      </collision>
    </link>

    <link name="${prefix}_camera_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0" />
        <inertia
          ixx="0" ixy="0" ixz="0"
          iyy="0" iyz="0"
          izz="0" />
      </inertial>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/camera_link.STL" />
        </geometry>
        <material name="">
          <color rgba="1 1 1 1" />
        </material>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry>
          <mesh filename="package://bucket_gripper/meshes/camera_link.STL" />
        </geometry>
      </collision>
    </link>

    <!-- ================================================================
         Joints
         ================================================================ -->

    <joint name="${prefix}_bucket_joint" type="fixed">
      <origin xyz="0 0 0.22243" rpy="0 0 0" />
      <parent link="${prefix}_base_link" />
      <child  link="${prefix}_bucket_link" />
    </joint>

    <joint name="${prefix}_adapter_joint" type="fixed">
      <origin xyz="0 0 0.1105" rpy="0 0 0" />
      <parent link="${prefix}_base_link" />
      <child  link="${prefix}_adapter_link" />
    </joint>

    <joint name="${prefix}_camera_joint" type="fixed">
      <origin xyz="0.1845 0.0015 0.11707" rpy="0 0 0" />
      <parent link="${prefix}_base_link" />
      <child  link="${prefix}_camera_link" />
    </joint>

  </xacro:macro>

</robot>
