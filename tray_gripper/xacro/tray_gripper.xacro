<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro">

    <xacro:macro name="tray_gripper"
        params="
        prefix:='tray_gripper' 
        connected_to:='' 
        *origin"
    >

        <!-- virtual joint -->
        <xacro:unless value="${not connected_to}">
            <joint name="${prefix}_vj" type="fixed">
                <parent link="${connected_to}" />
                <child link="${prefix}_base_link" />
                <xacro:insert_block name="origin" />
            </joint>
        </xacro:unless>

        <link
            name="${prefix}_base_link">
            <inertial>
                <origin
                    xyz="1.3918E-17 -0.0018924 0.010868"
                    rpy="0 0 0" />
                <mass
                    value="1.6375" />
                <inertia
                    ixx="0.0013196"
                    ixy="-3.504E-19"
                    ixz="-1.2996E-18"
                    iyy="0.0080644"
                    iyz="-5.7578E-05"
                    izz="0.009036" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tray_gripper/meshes/gripper_base_link.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.64706 0.61961 0.58824 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tray_gripper/meshes/gripper_base_link.STL" />
                </geometry>
            </collision>
        </link>
        <link
            name="${prefix}_rot">
            <inertial>
                <origin
                    xyz="4.3535E-05 0.015829 0.063039"
                    rpy="0 0 0" />
                <mass
                    value="3.8183" />
                <inertia
                    ixx="0.0020492"
                    ixy="3.0924E-07"
                    ixz="6.575E-06"
                    iyy="0.019033"
                    iyz="0.00014163"
                    izz="0.019448" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tray_gripper/meshes/gripper_rot.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="0.86667 0.86667 0.8902 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tray_gripper/meshes/gripper_rot.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_rot"
            type="fixed">
            <origin
                xyz="0 -0.00036751 0.03766"
                rpy="1.0472 0 0" />
            <parent
                link="${prefix}_base_link" />
            <child
                link="${prefix}_rot" />
            <axis
                xyz="0 0 0" />
        </joint>
        <link
            name="${prefix}_camera">
            <inertial>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <mass
                    value="0" />
                <inertia
                    ixx="0"
                    ixy="0"
                    ixz="0"
                    iyy="0"
                    iyz="0"
                    izz="0" />
            </inertial>
            <visual>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tray_gripper/meshes/gripper_camera.STL" />
                </geometry>
                <material
                    name="">
                    <color
                        rgba="1 1 1 1" />
                </material>
            </visual>
            <collision>
                <origin
                    xyz="0 0 0"
                    rpy="0 0 0" />
                <geometry>
                    <mesh
                        filename="package://tray_gripper/meshes/gripper_camera.STL" />
                </geometry>
            </collision>
        </link>
        <joint
            name="${prefix}_camera"
            type="fixed">
            <origin
                xyz="0 -0.0812 0.0263400000000001"
                rpy="1.5707963267949 0 0" />
            <parent
                link="${prefix}_base_link" />
            <child
                link="${prefix}_camera" />
            <axis
                xyz="0 0 1" />
        </joint>

    </xacro:macro>

</robot>