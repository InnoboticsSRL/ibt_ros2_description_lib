<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>robotiq_description</name>
  <version>1.0.0</version>
  <description>
    <p>URDF Description package for robotiq_description</p>
    <p>This package contains configuration data, 3D models and launch files for grip_exon robot</p>
  </description>

  <author>Alvin Matarozzo</author>
  <maintainer email="matarozzo@automationware.it">Alvin Matarozzo</maintainer>
  <maintainer email="deirossi@automationware.it">Mattia Dei Rossi</maintainer>
  <maintainer email="selvija@automationware.it">Armando Selvija</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <exec_depend>rclcpp</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>xacro</exec_depend>

  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>